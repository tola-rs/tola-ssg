%YAML 1.2
---
name: Nushell
scope: source.nu
file_extensions: [nu]

variables:
  end: '(?=$|[\s|;,()\[\]{}])'
  name: '[\p{L}_][\w-]*'
  variable: '[\p{L}_]\w*'
  quoted: >-
    (?:"(?:[^"\\]|\\.)*"|'[^']*'|`[^`]*`)
  keywords: >-
    (?:break|continue|export-env|if|loop|return|try|where|while)
  module_commands: '(?:hide|overlay|source(?:-env)?|use)'
  constants: '(?:false|null|true)'
  decimal: '[+-]?(?:\d[\d_]*(?:\.\d[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?'
  special_number: '(?:inf|nan|NaN)'
  range: '\.\.[=<]?'
  range_end: '(?={{end}}|[$(])'
  stdout: '(?:o|out)'
  stderr: '(?:e|err)'
  both_streams: '(?:o\+e|e\+o|out\+err|err\+out)'
  pipe: '(?:(?:{{stderr}}|{{both_streams}})>)?\|'
  flag: '(?:--\w[\w.?\-]*|-[\p{L}_:?@!%][\w:?@!%_-]*)'
  key: '(?:{{quoted}}|[\w-]+)'

contexts:
  main:
    - include: statement
    - include: code

  statement:
    # The line context prevents the start rule from retrying at the same position.
    - match: '^[ \t]*(?=[^\s)\]}])'
      push: [line, command-head]

  line:
    - match: '$|(?=[)\]}])'
      pop: true
    - include: code

  command-head:
    - match: '[%^](?=\S)'
      scope: keyword.operator.command.nu
      set: forced-command
    - match: '([A-Za-z_][A-Za-z0-9_]*)(=)'
      captures:
        1: variable.other.environment.nu
        2: keyword.operator.assignment.nu
      push: environment-value
    - include: declarations
    - match: 'match{{end}}'
      scope: keyword.control.nu
      set: [match-block-start, single-value-start]
    - match: '{{module_commands}}{{end}}'
      scope: keyword.control.import.nu
      set: arguments
    - match: '{{keywords}}{{end}}'
      scope: keyword.control.nu
      pop: true
    - match: '(?!(?:{{constants}}|{{special_number}}|not){{end}})(?:{{name}}|\.{1,2}/[^\s|;,()\[\]{}]+){{end}}'
      scope: variable.function.nu
      set: arguments
    - match: '(?=\S)|$'
      pop: true

  forced-command:
    - match: '(?=[$(])'
      set: arguments
    - match: '{{quoted}}{{end}}'
      scope: variable.function.nu
      set: arguments
    - match: '[^\s|;,()\[\]{}''"`]+'
      scope: variable.function.nu
      set: arguments
    - match: '(?=\S)|$'
      pop: true

  environment-value:
    - match: '(?=\s|[;|)\]}])|$'
      pop: true
    - include: strings
    - include: variables-and-paths
    - include: bare-word

  arguments:
    - include: arguments-end
    - match: '--{{end}}'
      scope: punctuation.separator.options.nu
      set: positional-arguments
    - include: flags
    - include: argument-values

  positional-arguments:
    - include: arguments-end
    - include: argument-values

  arguments-end:
    - match: '(?={{pipe}}|[;)\]}])|$'
      pop: true

  argument-values:
    - include: redirection
    - include: values
    - include: bare-word

  code:
    - include: values
    - include: redirection
    - include: operators
    - include: bare-word

  values:
    - match: '^#!.*'
      scope: comment.line.shebang.nu
    - include: comments
    - include: groups
    - include: strings
    - include: variables-and-paths
    - include: literals
    - match: '\.\.\.(?=[$\[({])'
      scope: keyword.operator.spread.nu
    - match: '-(?=[$(])'
      scope: keyword.operator.negation.nu
    - match: ','
      scope: punctuation.separator.nu

  comments:
    - match: '#.*'
      scope: comment.line.number-sign.nu

  bare-word:
    # Keep plain arguments intact, including hyphens and path separators.
    - match: '[^\s|;,()\[\]{}''"`]+'

  declarations:
    - match: 'export(?=[ \t]+(?:alias|const|def|extern|module|type|use){{end}})'
      scope: keyword.control.nu
    - match: '(type)[ \t]+({{name}})[ \t]+(=){{end}}'
      captures:
        1: keyword.declaration.nu
        2: entity.name.type.nu
        3: keyword.operator.assignment.nu
      set: type
    - match: '@{{name}}{{end}}'
      scope: storage.modifier.attribute.nu
      set: arguments
    - match: '(?:def|extern){{end}}'
      scope: keyword.declaration.function.nu
      set: function-name
    - match: '(alias|module)[ \t]+({{quoted}}|{{name}}){{end}}'
      captures:
        1: keyword.declaration.nu
        2: entity.name.nu
      pop: true
    - match: '(const|for|let|mut)[ \t]+(\$?{{variable}})(?=[:\s]|$)'
      captures:
        1: keyword.declaration.nu
        2: variable.other.nu
      set: binding-tail
    - match: '(?:alias|const|for|let|module|mut|type){{end}}'
      scope: keyword.control.nu
      pop: true

  binding-tail:
    - match: ':'
      scope: punctuation.separator.type.nu
      set: type
    - match: '(?=\S)|$'
      pop: true

  function-name:
    - include: flags
    - match: '(?:{{quoted}}|{{name}}){{end}}'
      scope: entity.name.function.nu
      set: signature-start
    - match: '(?=\S)|$'
      pop: true

  signature-start:
    - match: '\['
      scope: punctuation.section.parameters.begin.nu
      set: signature
    - match: '(?=\S)|$'
      pop: true

  signature:
    - match: '\]'
      scope: punctuation.section.parameters.end.nu
      set: signature-tail
    - include: parameters

  signature-tail:
    - match: ':'
      scope: punctuation.separator.type.nu
      set: input-output-types
    - match: '(?=\S)|$'
      pop: true

  input-output-types:
    - match: '\['
      scope: punctuation.section.brackets.begin.nu
      set: overloads
    - match: '(?=[{};])|$'
      pop: true
    - include: type-pair

  overloads:
    - match: '\]'
      scope: punctuation.section.brackets.end.nu
      pop: true
    - match: '(?=[{};])'
      pop: true
    - include: type-pair

  type-pair:
    - match: '->'
      scope: keyword.operator.type.nu
    - match: '(?={{name}})'
      push: type
    - include: type-separators

  parameters:
    - match: ':'
      scope: punctuation.separator.type.nu
      push: type
    - match: '='
      scope: keyword.operator.assignment.nu
      push: single-value-start
    - match: '({{flag}})(?:[ \t]*(\()(-[^ \t()\r\n])(\)))?(?=[:=]|{{end}})'
      captures:
        1: constant.other.option.nu
        2: punctuation.section.parameters.begin.nu
        3: constant.other.option.nu
        4: punctuation.section.parameters.end.nu
    - match: '(@)({{quoted}}|{{name}})?'
      captures:
        1: punctuation.separator.completion.nu
        2: variable.function.nu
    - match: '(?!{{constants}}{{end}})(\.\.\.)?(\$?{{variable}})(\?)?(?=$|[\s:,\]=|])'
      captures:
        1: keyword.operator.spread.nu
        2: variable.parameter.nu
        3: keyword.operator.optional.nu
    - include: code

  type:
    - match: '((?:list|oneof))(<)'
      captures:
        1: storage.type.nu
        2: punctuation.section.type.begin.nu
      set: type-arguments
    - match: '((?:record|table))(<)'
      captures:
        1: storage.type.nu
        2: punctuation.section.type.begin.nu
      set: type-fields
    - match: '{{name}}'
      scope: storage.type.nu
      pop: true
    - include: comments
    - match: '(?=\S)'
      pop: true

  type-arguments:
    - include: type-end
    - match: '(?={{name}})'
      push: type
    - include: type-separators

  type-fields:
    - include: type-end
    - match: '({{key}})[ \t]*(:)'
      captures:
        1: variable.other.member.nu
        2: punctuation.separator.type.nu
      push: type
    - match: '{{key}}'
      scope: variable.other.member.nu
    - include: type-separators

  type-end:
    - match: '>'
      scope: punctuation.section.type.end.nu
      pop: true
    - match: '(?=[\[\]{});|=])'
      pop: true

  type-separators:
    - include: comments
    - match: ','
      scope: punctuation.separator.nu

  groups:
    - match: '\('
      scope: punctuation.section.parens.begin.nu
      push: [subexpression, command-head]
    - match: '\['
      scope: punctuation.section.brackets.begin.nu
      push: list
    - match: '\{'
      scope: punctuation.section.braces.begin.nu
      push: brace-head

  subexpression:
    - match: '\)'
      scope: punctuation.section.parens.end.nu
      set: cell-path
    - include: main

  list:
    - match: '\]'
      scope: punctuation.section.brackets.end.nu
      set: cell-path
    - match: ';'
      scope: punctuation.separator.table.nu
    - include: values
    - include: bare-word

  brace-head:
    - match: '\|'
      scope: punctuation.section.parameters.begin.nu
      set: [block, closure-parameters]
    - match: '(?={{key}}[ \t]*:|\.\.\.[$({])'
      set: record
    - include: comments
    - match: '(?=\S)'
      set: [block, command-head]

  record:
    - match: '\}'
      scope: punctuation.section.braces.end.nu
      set: cell-path
    - match: '({{key}})[ \t]*(:)(?!//)'
      captures:
        1: variable.other.member.nu
        2: punctuation.separator.key-value.nu
    - include: values
    - include: bare-word

  closure-parameters:
    - match: '\|'
      scope: punctuation.section.parameters.end.nu
      set: command-head
    - match: '(?=\})'
      pop: true
    - include: parameters

  block:
    - match: '\}'
      scope: punctuation.section.braces.end.nu
      set: block-tail
    - include: main

  block-tail:
    - match: '[ \t]+(catch|else|finally){{end}}'
      captures:
        1: keyword.control.nu
      set: command-head
    - include: cell-path

  match-block-start:
    - match: '\{'
      scope: punctuation.section.braces.begin.nu
      set: match-block
    - match: '(?=\S)|$'
      pop: true

  match-block:
    - match: '\}'
      scope: punctuation.section.braces.end.nu
      pop: true
    - match: '=>{{end}}'
      scope: keyword.operator.match.nu
      push: single-value-start
    - match: 'if{{end}}'
      scope: keyword.control.nu
    - match: '\|'
      scope: keyword.operator.pattern.nu
    - match: '_{{end}}'
      scope: constant.language.wildcard.nu
    - include: code

  single-value-start:
    - match: '(?=[^\s,;|)\]}])'
      set: single-value
    - match: '(?=\S)|$'
      pop: true

  single-value:
    - match: '(?=[\s,;|)\]}])|$'
      pop: true
    - include: values
    - include: bare-word

  variables-and-paths:
    - match: '\$(?=\.(?!\.))'
      scope: variable.other.nu
      push: cell-path
    - match: '\$(?:env|in|nu)(?![\w-])'
      scope: variable.language.nu
      push: cell-path
    - match: '\${{variable}}(?![\w-])'
      scope: variable.other.nu
      push: cell-path

  cell-path:
    - match: '(\.)({{quoted}}|[^.\s?!|;,():\[\]{}''"`]+)([?!][?!]?)?'
      captures:
        1: punctuation.accessor.dot.nu
        2: variable.other.member.nu
        3: keyword.operator.member.nu
    - match: '{{range}}{{range_end}}'
      scope: keyword.operator.range.nu
      pop: true
    - match: ''
      pop: true

  flags:
    - match: '({{flag}})(?:(=)|{{end}})'
      captures:
        1: constant.other.option.nu
        2: keyword.operator.assignment.nu

  redirection:
    - match: '(?:{{stdout}}|{{stderr}}|{{both_streams}})>>?(?!\|){{end}}'
      scope: keyword.operator.redirection.nu

  operators:
    - match: '{{pipe}}'
      scope: keyword.operator.pipe.nu
      push: command-head
    - match: ';'
      scope: punctuation.terminator.nu
      push: command-head
    - match: '(?:\+\+=|[+*/-]?=){{end}}'
      scope: keyword.operator.assignment.nu
      push: command-head
    - match: >-
        (?:\*\*|//|\+\+|==|!=|<=|>=|=~|!~|[+*/<>-]){{end}}
      scope: keyword.operator.nu
    - match: >-
        (?:and|or|xor|not|mod|in|not-in|has|not-has|(?:not-)?(?:starts-with|ends-with|like)|older-than|newer-than|bit-(?:and|or|xor|shl|shr)){{end}}
      scope: keyword.operator.word.nu

  literals:
    - match: '{{constants}}{{end}}'
      scope: constant.language.nu
    - match: '\d{4}-\d{2}-\d{2}(?:[Tt]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-]\d{2}:\d{2})?)?{{end}}'
      scope: constant.other.datetime.nu
    - match: '(?={{decimal}}\.\.|{{range}}(?:{{decimal}}|[$(]))({{decimal}})?(?:(\.\.)({{decimal}}))?({{range}})({{decimal}})?{{range_end}}'
      captures:
        1: constant.numeric.nu
        2: keyword.operator.range.nu
        3: constant.numeric.nu
        4: keyword.operator.range.nu
        5: constant.numeric.nu
    - match: '({{decimal}})((?i:[kmgtpe]i?b|b)|ns|us|µs|ms|sec|min|hr|day|wk){{end}}'
      captures:
        1: constant.numeric.nu
        2: storage.type.unit.nu
    - match: '(?:{{decimal}}|[+-]?(?:0(?:x[\da-fA-F_]+|o[0-7_]+|b[01_]+)|{{special_number}})){{end}}'
      scope: constant.numeric.nu
    - match: '0[xob]\['
      scope: punctuation.section.brackets.begin.nu
      push: binary

  binary:
    - meta_scope: constant.numeric.binary.nu
    - match: '\]'
      scope: punctuation.section.brackets.end.nu
      pop: true
    - include: comments

  strings:
    - match: "r(#+)'"
      scope: punctuation.definition.string.begin.nu
      push: raw-string
    - match: '\$"'
      scope: punctuation.definition.string.begin.nu
      push: interpolated-double
    - match: "\\$'"
      scope: punctuation.definition.string.begin.nu
      push: interpolated-single
    - match: '"'
      scope: punctuation.definition.string.begin.nu
      push: double-string
    - match: "'"
      scope: punctuation.definition.string.begin.nu
      push: single-string
    - match: '`'
      scope: punctuation.definition.string.begin.nu
      push: backtick-string

  raw-string:
    - meta_scope: string.quoted.other.raw.nu
    - match: "'\\1"
      scope: punctuation.definition.string.end.nu
      pop: true

  interpolated-double:
    - meta_scope: string.interpolated.double.nu
    - include: interpolation
    - include: double-string

  interpolated-single:
    - meta_scope: string.interpolated.single.nu
    - include: interpolation
    - include: single-string

  interpolation:
    - match: '\('
      scope: punctuation.section.interpolation.begin.nu
      push: [interpolation-body, command-head]

  interpolation-body:
    - meta_scope: meta.interpolation.nu
    - match: '\)'
      scope: punctuation.section.interpolation.end.nu
      pop: true
    - include: main

  double-string:
    - meta_scope: string.quoted.double.nu
    - match: '\\(?:u\{[\da-fA-F]+\}|.)'
      scope: constant.character.escape.nu
    - match: '"'
      scope: punctuation.definition.string.end.nu
      pop: true

  single-string:
    - meta_scope: string.quoted.single.nu
    - match: "''"
    - match: "'"
      scope: punctuation.definition.string.end.nu
      pop: true

  backtick-string:
    - meta_scope: string.quoted.other.nu
    - match: '`'
      scope: punctuation.definition.string.end.nu
      pop: true
