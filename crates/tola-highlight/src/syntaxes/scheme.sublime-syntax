%YAML 1.2
---
# https://www.sublimetext.com/docs/syntax.html
#
# `Scheme` Language Reference: http://www.r6rs.org/final/r6rs.pdf
#

name: Scheme
version: 2
# Tola: use these fence tags. The syntax rules are unchanged.
file_extensions: [scheme, scm, ss, sld, r5rs, r6rs, r7rs, chez, chez-scheme, guile, chicken, chicken-scheme, gauche, gambit, chibi-scheme, mit-scheme]
scope: source.scheme

contexts:
  main:
    - include: invalid-close-paren
    - include: invalid-close-brack
    - include: expression

  expression:
    - match: (?=\S)
      push: pop-on-expression

  pop-on-expression:
    - include: pop-before-wrapper
    - include: push-after-wrapper
    - include: macro-keywords
    - include: aux-keywords
    - include: primitive
    - include: constants
    - include: other-variable
    - include: comments
    - include: gensym-literal

  pop-before-wrapper:
    - match: (?=[\])])
      pop: 1

  push-after-wrapper:
    - match: \(
      scope: punctuation.paren.begin.scheme
      push: [pop-2-on-close-paren, expressions, form-of-paren]

    - match: \[
      scope: punctuation.bracket.begin.scheme
      push: [pop-2-on-close-brack, expressions, form-of-brack]

  form-of-brack:
    - include: special-forms
    - include: pop-on-expression

  form-of-paren:
    - include: special-forms
    - include: constants
    - include: application
    - include: pop-on-expression

  expressions:
    - match: (?=\S)
      set: pop-1-before-wrapper-expression

  pop-1-before-wrapper-expression:
    - include: pop-before-wrapper
    - include: expression

  pop-2-before-wrapper-expression:
    - match: (?=[\])])
      pop: 2
    - include: expression

  special-forms:
    - match: let(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.let.scheme
        - include: let-form

    - match: lambda(?={{delimiters}})
      scope:
        storage.type.function.inline.scheme
        keyword.declaration.function.inline.scheme
      push: lambda-form

    - match: '{{definition_keywords}}(?={{delimiters}})'
      scope: keyword.declaration.scheme
      push: define-form

    - match: set(?:!|-who!)(?={{delimiters}})
      scope: keyword.assignment.scheme
      push: set-form

    - match: case(?={{delimiters}})
      scope: keyword.control.scheme
      push: case-form

    - match: case-lambda(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.case-lambda.scheme
        - include: case-clauses

    - match: syntax-case(?={{delimiters}})
      scope: keyword.control.syntax.scheme
      push: syntax-case-form

    - match: syntax-rules(?={{delimiters}})
      scope: keyword.control.syntax.scheme
      push: syntax-rules-form

    - match: with-syntax(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.with-syntax.scheme
        - include: let-form

    - match: let\*(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.let*.scheme
        - include: let-form

    - match: letrec(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.letrec.scheme
        - include: let-form

    - match: let-values(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.let-values.scheme
        - include: let-form

    - match: do(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.do.scheme
        - include: let-form

    - match: fluid-let(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.fluid-let.scheme
        - include: let-form

    - match: letrec\*(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.letrec*.scheme
        - include: let-form

    - match: let-syntax(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.let-syntax.scheme
        - include: let-form

    - match: letrec-syntax(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.letrec-syntax.scheme
        - include: let-form

    - match: let\*-values(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.let*-values.scheme
        - include: let-form

    - match: fluid-let-syntax(?={{delimiters}})
      scope: keyword.control.scheme
      push:
        - meta_scope: meta.fluid-let-syntax.scheme
        - include: let-form

    - match: '{{keywords}}(?={{delimiters}})'
      scope: keyword.control.scheme
      push: expressions

  let-form:
    - include: let-binding-list
    - include: named-let-form
    - include: expressions

  named-let-form:
    - match: '{{identifier}}'
      scope: entity.name.function.scheme
      set:
        - meta_scope: meta.named-let.scheme
        - include: let-binding-list
        - include: expressions

  let-binding-list:
    - match: \(
      scope: punctuation.paren.begin.scheme
      push: [let-body, let-bindings]

  let-body:
    - match: (?=[\])])
      pop: 4
    - include: expression

  let-bindings:
    - match: \[
      scope: punctuation.bracket.begin.scheme
      push: [pop-1-on-close-brack, let-var-exp]
    - match: \(
      scope: punctuation.paren.begin.scheme
      push: [pop-1-on-close-paren, let-var-exp]
    - include: pop-1-on-close-paren
    - include: expression

  let-var-exp:
    - match: '{{identifier}}'
      scope: variable.parameter.scheme
      set: expressions
    - match: \(
      scope: punctuation.paren.begin.scheme
      set: [expressions, parameters-wrapped-by-paren]
    - match: \[
      scope: punctuation.bracket.begin.scheme
      set: [expressions, parameters-wrapped-by-brack]
    - match: (?=\S)
      set: expressions

  case-form:
    - meta_scope: meta.case.scheme
    - match: (?=\S)
      set: [case-clauses, pop-on-expression]

  case-clauses:
    - meta_scope: meta.case.scheme
    - match: \[
      scope: punctuation.bracket.begin.scheme
      push:
        - include: pop-1-on-close-brack
        - include: pattern-begin
    - match: \(
      scope: punctuation.paren.begin.scheme
      push:
        - include: pop-1-on-close-paren
        - include: pattern-begin
    - include: pop-1-before-wrapper-expression

  pattern-begin:
    - match: \(
      scope: punctuation.paren.begin.scheme
      push: [expressions, pattern-list-paren]
    - match: \[
      scope: punctuation.bracket.begin.scheme
      push: [expressions, pattern-list-brack]
    - match: else|_
      scope: keyword.control.scheme
      push: expressions
    - match: '{{identifier}}'
      scope: variable.parameter.scheme
      push: expressions
    - include: pop-1-before-wrapper-expression

  pattern-list-paren:
    - include: pop-1-on-close-paren
    - match: (?=\S)
      push: pattern-content

  pattern-list-brack:
    - include: pop-1-on-close-brack
    - match: (?=\S)
      push: pattern-content

  pattern-content:
    - include: constants
    - include: aux-keywords
    - match: '{{identifier}}'
      scope: constant.symbol.literal.scheme
      pop: 1
    - include: pop-1-before-wrapper-expression

  lambda-form:
    - match: \(
      scope: punctuation.paren.begin.scheme
      set: [lambda-body, parameters-wrapped-by-paren]
    - match: '{{identifier}}'
      scope: variable.parameter.scheme
      set: lambda-body
    - include: expressions

  lambda-body:
    - meta_scope: meta.lambda.scheme
    - include: pop-1-before-wrapper-expression

  define-form:
    - match: '{{identifier}}'
      scope: entity.name.function.scheme
      push: define-body
    - match: \(
      scope: punctuation.paren.begin.scheme
      push:
        - match: '{{identifier}}'
          scope: entity.name.function.scheme
          set: [define-body, parameters-wrapped-by-paren]
        - match: (?=\S)
          set: [define-body, parameters-wrapped-by-paren, pop-on-expression]
    - include: expressions

  define-body:
    - include: pop-2-before-wrapper-expression

  set-form:
    - match: '{{identifier}}'
      scope: entity.name.function.scheme
      set: pop-1-before-wrapper-expression
    - include: expressions

  syntax-rules-form:
    - meta_scope: meta.syntax-rules.scheme
    - include: syntax-case-body

  syntax-case-form:
    - meta_scope: meta.syntax-case.scheme
    - match: (?=\S)
      set: [syntax-case-body, pop-on-expression]

  syntax-case-body:
    - meta_scope: meta.syntax-case.scheme
    - match: \(
      scope: punctuation.paren.begin.scheme
      push: [syntax-case-clauses, syntax-case-literals]
    - include: expressions

  syntax-case-literals:
    - match: \)
      scope: punctuation.paren.end.scheme
      pop: 1
    - match: \.|\.{3}
      scope: keyword.control.scheme
    - match: '{{identifier}}'
      scope: constant.symbol.literal.scheme
    - include: comments

  syntax-case-clauses:
    - include: pop-2-before-wrapper-expression

  parameters-wrapped-by-paren:
    - match: \.|\.{3}
      scope: keyword.control.scheme
    - include: parameter
    - include: pop-1-on-close-paren
    - include: comments
    - include: expression

  parameters-wrapped-by-brack:
    - match: \.|\.{3}
      scope: keyword.control.scheme
    - include: parameter
    - include: pop-1-on-close-brack
    - include: comments
    - include: expression

  parameter:
    - match: '{{identifier}}'
      scope: variable.parameter.scheme

  application:
    - match: '#[23]?%'
      scope:
        keyword.control.optimize-level.scheme
        prefix.primitive.scheme
      set:
        - match: '{{primitives}}(?={{delimiters}})'
          scope:
            meta.function-call.scheme
            support.function.scheme
            primitive.function.scheme
          set: expressions
        - match: '{{identifier}}(?={{delimiters}})'
          scope:
            meta.function-call.scheme
            primitive.function.scheme
          set: expressions
    - match: '{{primitives}}(?={{delimiters}})'
      scope:
        meta.function-call.scheme
        support.function.scheme
      set: expressions
    - match: '{{identifier}}(?={{delimiters}})'
      scope:
        meta.function-call.scheme
        variable.function.scheme
      set: expressions

  aux-keywords:
    - match: (?:\.{3}|\.|_|=>)(?={{delimiters}})
      scope: keyword.aux.scheme
      pop: 1

  other-variable:
    - match: '{{identifier}}|[{}]'
      scope: entity.other.scheme
      pop: 1

  primitive:
    - match: '{{primitives}}(?={{delimiters}})'
      scope: support.function.scheme
      pop: 1
    - match: '#(?:[23]?%)'
      scope:
        keyword.control.optimize-level.scheme
        prefix.primitive.scheme
      push:
        - match: '{{primitives}}(?={{delimiters}})'
          scope:
            support.function.scheme
            primitive.function.scheme
          pop: 2
        - match: '{{identifier}}(?={{delimiters}})'
          scope: primitive.function.scheme
          pop: 2

  macro-keywords:
    - match: "#'"
      scope: keyword.syntax.scheme
      push:
        - meta_scope: meta.syntax.scheme
        - match: (?=\S)
          push: [always-pop-3, pop-on-expression]
    - match: '#`'
      scope: keyword.quasisyntax.scheme
      push:
        - meta_scope: meta.quasisyntax.scheme
        - match: (?=\S)
          push: [always-pop-3, pop-on-expression]
    - match: '#,@'
      scope: keyword.unsyntax-splicing.scheme
      push:
        - meta_scope: meta.unsyntax-splicing.scheme
        - match: (?=\S)
          push: [always-pop-3, pop-on-expression]
    - match: '#,'
      scope: keyword.unsyntax.scheme
      push:
        - meta_scope: meta.unsyntax.scheme
        - match: (?=\S)
          push: [always-pop-3, pop-on-expression]
    - match: "'"
      scope: keyword.quote.scheme
      push:
        - meta_scope: meta.quote.scheme
        - match: (?=\S)
          push: [always-pop-3, quote-constants]
    - match: '`'
      scope: keyword.quasiquote.scheme
      push:
        - meta_scope: meta.quasiquote.scheme
        - match: (?=\S)
          push: [always-pop-3, quote-constants]
    - match: ',@'
      scope: keyword.unquote-splicing.scheme
      push:
        - meta_scope: meta.unquote-splicing.scheme
        - match: (?=\S)
          push: [always-pop-3, pop-on-expression]
    - match: ','
      scope: keyword.unquote.scheme
      push:
        - meta_scope: meta.unquote.scheme
        - match: (?=\S)
          push: [always-pop-3, pop-on-expression]
    - match: '#([0-9]*)vu8(?=\()'
      scope: storage.modifier.bytevector.scheme
      captures:
        1: constant.numeric.scheme
      set:
        - meta_scope: meta.bytevector.scheme
        - include: pop-on-expression
    - match: '#([0-9]*)vfx(?=\()'
      scope: storage.modifier.fxvector.scheme
      captures:
        1: constant.numeric.scheme
      set:
        - meta_scope: meta.fxvector.scheme
        - include: pop-on-expression
    - match: '#([0-9]*)(?=\()'
      scope: storage.modifier.vector.scheme
      captures:
        1: constant.numeric.scheme
      set:
        - meta_scope: meta.vector.scheme
        - include: pop-on-expression
    - match: '#&'
      scope: storage.modifier.boxes.scheme
      set: pop-on-expression
    - match: '#@'
      scope: storage.modifier.fasl.scheme
      set: pop-on-expression
    - match: '#([0-9]+)='
      scope: storage.modifier.pair.scheme
      captures:
        1: constant.numeric.scheme
      set: pop-on-expression
    - match: '#(?=\[)'
      scope: storage.modifier.record-name.scheme
      set: pop-on-expression

  quote-constants:
    - include: constants
    - match: '{{identifier}}'
      scope: symbol.quoted.scheme
      pop: 1
    - match: \(\)
      scope: constant.language.scheme
      pop: 1
    - include: pop-on-expression

  gensym-literal:
    - match: (#\{)({{identifier}})\s+({{identifier}})(\})
      captures:
        1: storage.modifier.gensym.begin.scheme
        2: string.gensym.pretty-name.scheme
        3: string.gensym.unique-name.scheme
        4: storage.modifier.gensym.end.scheme
      pop: 1

  constants:
    - include: boolean
    - include: numerical
    - include: character
    - include: string-literal
    - match: '#!(?:r6rs|base-rtd|bwp|chezscheme|(no-)?fold-case)'
      scope: constant.language.scheme
      set: delimiter

  boolean:
    - match: '#(?:false|f|true|t)'
      scope: constant.boolean.scheme
      set: delimiter

  numerical:
    - match: |-
        (?x)
        (\#[dD](?:\#[eEiI])?|\#[eEiI](?:\#[dD])?)?
        (?:[-\+]?(?:(?:[0-9]+(?:\.[0-9]*|/[0-9]+)?)|\.[0-9]+)
          (?:[eE][-\+]?[0-9]+)?)
        (?={{delimiters}})
      scope: constant.numeric.decimal.scheme
      captures:
        1: storage.modifier.numeric.scheme
      pop: 1
    - match: |-
        (?x)
        (\#[bB](?:\#[eEiI])?|\#[eEiI]\#[bB])
        (?:[+-]?(?:(?:[01]+(?:\.[01]*|/[01]+)?)|\.[01]+)
          (?:[eE][-\+]?[01]+)?)
      scope: constant.numeric.binary.scheme
      captures:
        1: storage.modifier.numeric.scheme
      set: delimiter
    - match: |-
        (?x)
        (\#[oO](?:\#[eEiI])?|\#[eEiI]\#[oO])
        (?:[+-]?(?:(?:[0-7]+(?:\.[0-7]*|/[0-7]+)?)|\.[0-7]+)
          (?:[eE][-\+]?[0-7]+)?)
      scope: constant.numeric.octal.scheme
      captures:
        1: storage.modifier.numeric.scheme
      set: delimiter
    - match: |-
        (?x)
        (\#[xX](?:\#[eEiI])?|\#[eEiI]\#[xX])
        (?:[-\+]?[0-9a-fA-F]+[\./]?[0-9a-fA-F]*)
      scope: constant.numeric.hex.scheme
      captures:
        1: storage.modifier.numeric.scheme
      set: delimiter
    # #<2..36>r
    - match: |-
        (?x)
        (\#(?:0?[2-9]|[1-3][0-6])[rR](?:\#[eEiI])?|\#[eEiI]\#
          (?:0?[2-9]|[1-3][0-6])[rR])
        (?:[-\+]?[0-9a-zA-Z]+\.?[0-9a-zA-Z]*)
      scope: constant.numeric.various.scheme
      captures:
        1: storage.modifier.numeric.scheme
      set: delimiter

  character:
    - match: (#\\x)([0-9a-fA-F]+)\b
      captures:
        1: storage.modifier.character.scheme
        2: constant.character.numeric.hex.scheme
      pop: 1
    - match: (#\\0)([0-7]{2})\b
      captures:
        1: storage.modifier.character.scheme
        2: constant.character.numeric.octal.scheme
      pop: 1
    - match: (#\\)([0-9]{2,})\b
      captures:
        1: storage.modifier.character.scheme
        2: constant.character.numeric.decimal.scheme
      pop: 1
    - match: '#\\'
      scope: storage.modifier.character.scheme
      set:
        - match: |-
            (?x)
            (?:alarm|backspace|delete|esc|linefeed|newline|page
              |return|space|tab|bel|ls|nel|nul|rubout|vtab|vt|[ \S])
          scope: constant.character.scheme
          set: delimiter

  string-literal:
    - match: '"'
      scope: punctuation.definition.string.begin.scheme
      set:
        - meta_scope: string.quoted.double.scheme
        - match: '"'
          scope: punctuation.definition.string.end.scheme
          pop: 1
        - include: string-escaped-char
        - include: string-placeholder

  string-escaped-char:
    - match: '(\\)$\n'
      captures:
        1: punctuation.separator.continuation.scheme
    - match: '{{valid_escaped_chars}}'
      scope: constant.character.escape.scheme
    - match: \\.
      scope: invalid.illegal.unknown-escape.scheme

  string-placeholder:
    - match: |-
        (?x)~
        (?:[~nN%^&*;]
          |@?[?]
          |,?(?:\d+)?@?[eEfFgGtT]
          |,?(?:@:|:@|@|:)?[bBoOdDxX$]
          |(?:@:|:@|@|:)?[cC]
          |(?:\d+)?(?:@:|:@|@|:)?[aArRsSwW]
          |@:?\(
          |\)
          |:p)
      scope: constant.other.placeholder.scheme

  comments:
    - include: comment-expression
    - include: comment-line
    - include: comment-block
    - include: comment-eof

  comment-expression:
    - match: '#;'
      scope: punctuation.definition.comment.expression.scheme
      push:
        - meta_scope: meta.comment.expression.scheme
        - match: (?=\S)
          push: [always-pop-2, pop-on-expression]

  comment-line:
    - match: (;+).*$\n?
      scope: comment.line.scheme
      captures:
        1: punctuation.definition.comment.scheme
    - match: '#!(?=\s*/)'
      scope: comment.line.scheme
      push:
        - match: /([^/]+/)*(scheme|petite)\s+--script$
          scope: comment.line.scheme
          pop: 1
        - match: \S+(?=\s*$)
          scope: invalid.deprecated.scheme
          pop: 1

  comment-block:
    - match: '#\|'
      scope: punctuation.definition.comment.begin.scheme
      push:
        - meta_scope: comment.block.scheme
        - include: comment-block
        - match: '\|#'
          scope: punctuation.definition.comment.end.scheme
          pop: 1

  comment-eof:
    - match: ^\s*#!eof\b
      scope: keyword.control.eof.scheme
      push:
        - meta_scope: meta.comment.eof.scheme
        - include: pop-1-before-wrapper-expression
    - match: ^\s*#!eof\S
      scope: invalid.illegal.scheme

  delimiter:
    - match: (?={{delimiters}})
      pop: 1
    - match: \S+
      scope: invalid.illegal.delimiter.scheme
      pop: 1

  always-pop-2:
    - match: ''
      pop: 2

  always-pop-3:
    - match: ''
      pop: 3

  pop-1-on-close-brack:
    - match: \]
      scope: punctuation.bracket.end.scheme
      pop: 1
    - include: invalid-close-paren

  pop-1-on-close-paren:
    - match: \)
      scope: punctuation.paren.end.scheme
      pop: 1
    - include: invalid-close-brack

  pop-2-on-close-brack:
    - match: \]
      scope: punctuation.bracket.end.scheme
      pop: 2
    - include: invalid-close-paren

  pop-2-on-close-paren:
    - match: \)
      scope: punctuation.paren.end.scheme
      pop: 2
    - include: invalid-close-brack

  invalid-close-brack:
    - match: \]
      scope: invalid.illegal.close-bracket.scheme

  invalid-close-paren:
    - match: \)
      scope: invalid.illegal.close-paren.scheme


variables:
  valid_escaped_chars: |-
    (?x)\\
    (?:[\\abefnrtv\'"?]
      |[0-3][0-9]{0,2}
      |[4-7][0-9]?
      |x[a-fA-F0-9]+
      |u[a-fA-F0-9]{4}
      |U[a-fA-F0-9]{8})

  delimiters: (?:[{(\[\s"'`,;#\])}])
  identifier: |-
    (?x)
    (?:[^({\[#"'`,;|\\\s\]})]
      |\\[({\[#"'`,;|\\\s\]})]
      |\\x[0-9a-fA-F]*;
      |\|[^|]*\|)+
  definition_keywords: |-
    (?x)
    (?:define(?:-(?:condition-type
                   |enumeration
                   |ftype
                   |property
                   |record(?:-type)?
                   |s(?:tructure|yntax)
                   |values))?
      |trace-define(?:-syntax)?)
  keywords: |-
    (?x)
    (?:\$(?:primitive|system)
      |\&(?:assertion
           |con(?:dition|tinuation)
           |error
           |format
           |i(?:/o(?:-(?:decoding
                        |encoding
                        |file(?:-(?:already-exists
                                   |does-not-exist
                                   |is-read-only
                                   |protection)
                               |name)
                        |invalid-position
                        |port
                        |read
                        |write))?
               |mplementation-restriction
               |rritants)
           |lexical
           |message
           |no(?:-(?:infinities|nans)|n-continuable)
           |s(?:erious|ource|yntax)
           |undefined
           |violation
           |w(?:arning|ho))
      |\.\.\.
      |=>
      |_
      |a(?:dd-prefix|lias|n(?:d|notation-options)|ssert)
      |b(?:egin|uffer-mode)
      |c(?:ase(?:-lambda)?|on(?:d|structor)|ritical-section)
      |d(?:atum|elay|o|rop-prefix)
      |e(?:lse
          |ndianness
          |ol-style
          |rror-handling-mode
          |val-when
          |x(?:c(?:ept|lusive-cond)|p(?:ort|ression-editor)|tend-syntax))
      |f(?:asl-strip-options
          |i(?:elds|le-options)
          |luid-let(?:-syntax)?
          |oreign-(?:callable|procedure)
          |type-(?:\&ref
                  |guardian
                  |init-lock!
                  |lock(?:!|ed-(?:decr!|incr!))
                  |pointer\?
                  |ref
                  |s(?:et!|izeof|pin-lock!)
                  |unlock!))
      |guard
      |i(?:dentifier-syntax
          |eee
          |f
          |m(?:mutable|p(?:licit-exports|ort(?:-only)?))
          |n(?:clude|direct-export))
      |l(?:ambda
