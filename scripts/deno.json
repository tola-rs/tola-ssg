{
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.21/bdd",
    "@zip.js/zip.js": "npm:@zip.js/zip.js@2.20.0",
    "diff": "npm:diff@9.0.0",
    "tar-stream": "npm:tar-stream@3.2.1",
    "toml-eslint-parser": "npm:toml-eslint-parser@1.0.3",
    "unicode-case-folding": "npm:unicode-case-folding@1.1.1"
  },
  "tasks": {
    "typecheck": "deno check .",
    "format": "deno fmt --check .",
    "test": "deno test -A --trace-leaks --parallel",
    "test-names": "deno run --allow-read=.. test-names.ts",
    "check": "deno task typecheck && deno task test && deno run --allow-run check.ts"
  }
}
