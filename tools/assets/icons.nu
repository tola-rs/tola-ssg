#!/usr/bin/env nu
# Regenerate the Iconify collection index Tola pins.
#
# Check each named collection's newest npm release and append the releases that are not pinned
# yet; without names, check every collection Iconify publishes. Pinned releases stay in the table.

const TABLE = 'crates/tola-build/src/icon/iconify/releases.rs'
const COLLECTIONS = 'https://api.iconify.design/collections'
const NPM = 'https://registry.npmjs.org/@iconify-json'
const CDN = 'https://cdn.jsdelivr.net/npm/@iconify-json'
const CONCURRENCY = 8

const HEADER = "// Generated by `just tools::icons-index`; regenerate it instead of editing it.
//
// Releases are in ascending order, so the newest — the release a preset without a version
// resolves to — is last."

# Every release the table pins, keyed by collection name.
def parse-table [source: string] {
    let at = ($source | str index-of 'INDEXED_COLLECTIONS')
    if $at < 0 { return [] }
    $source | str substring $at.. | split row 'IndexedCollection {' | skip 1 | each {|block|
        let name = ($block | parse -r 'name:\s*"(?<name>[^"]*)"' | get -o 0.name)
        if $name == null { error make { msg: 'the table names a collection without a name' } }
        let releases = ($block | split row 'PinnedRelease {' | skip 1 | each {|release|
            let version = ($release | parse -r 'version:\s*"(?<version>[^"]*)"' | get -o 0.version)
            let sha256 = ($release | parse -r 'sha256:\s*Sha256Digest::from_hex\(\s*"(?<sha256>[0-9a-f]{64})"' | get -o 0.sha256)
            if $version == null or $sha256 == null {
                error make { msg: $"the table pins an incomplete release of ($name)" }
            }
            { version: $version, sha256: $sha256 }
        })
        if ($releases | is-empty) { error make { msg: $"the table pins no release of ($name)" } }
        { name: $name, releases: $releases }
    }
}

# Order releases by version, so the newest stays last.
def compare-releases [left: string, right: string] {
    let left_parts = ($left | str replace --all --regex '[.+-]' '.' | split row '.')
    let right_parts = ($right | str replace --all --regex '[.+-]' '.' | split row '.')
    let count = ([($left_parts | length) ($right_parts | length)] | math max)
    (0..<$count | reduce --fold 0 {|index, found|
        if $found != 0 {
            $found
        } else {
            let left_part = ($left_parts | get -o $index | default '')
            let right_part = ($right_parts | get -o $index | default '')
            let left_number = ($left_part | parse -r '^(?<number>-?[0-9]+)' | get -o 0.number)
            let right_number = ($right_part | parse -r '^(?<number>-?[0-9]+)' | get -o 0.number)
            if $left_number == null or $right_number == null {
                if $left_part == $right_part { 0 } else if $left_part < $right_part { -1 } else { 1 }
            } else {
                let left_value = ($left_number | into int)
                let right_value = ($right_number | into int)
                if $left_value == $right_value { 0 } else if $left_value < $right_value { -1 } else { 1 }
            }
        }
    })
}

# Insert each release after the versions it names, so the newest stays last.
def sort-releases [releases: list] {
    $releases | reduce --fold [] {|release, ordered|
        let at = (
            $ordered | enumerate
            | where {|entry| (compare-releases $entry.item.version $release.version) > 0 }
            | get -o 0.index
        )
        if $at == null { $ordered | append $release } else { $ordered | insert $at $release }
    }
}

# The table's text, before rustfmt wraps it.
def render [collections: list] {
    let lines = [
        $HEADER
        ''
        'use super::{IndexedCollection, PinnedRelease};'
        'use crate::config::section::Sha256Digest;'
        ''
        'pub(super) const INDEXED_COLLECTIONS: &[IndexedCollection] = &['
    ]
    let body = (
        $collections | sort-by name | each {|collection|
            let releases = ($collection.releases | each {|release|
                [
                    '            PinnedRelease {'
                    $"                version: ($release.version | to json),"
                    $"                sha256: Sha256Digest::from_hex\(($release.sha256 | to json)\),"
                    '            },'
                ]
            } | flatten)
            ([
                '    IndexedCollection {'
                $"        name: ($collection.name | to json),"
                '        releases: &['
            ] ++ $releases ++ [
                '        ],'
                '    },'
            ])
        } | flatten
    )
    $lines ++ $body ++ ['];' ''] | str join (char newline)
}

# Fetch one URL, retrying transport failures: the CDN and npm both drop connections under load.
def fetch [url: string] {
    mut response = { status: 0, body: '' }
    for attempt in 1..3 {
        $response = (try { http get --allow-errors --raw --full $url } catch {|failure| { status: 0, body: $failure.msg } })
        if $response.status in [200 403] { return $response }
        sleep 1sec
    }
    $response
}

def published [] {
    let response = (fetch $COLLECTIONS)
    if $response.status != 200 { error make { msg: $"($COLLECTIONS) answered ($response.status)" } }
    $response.body | from json | columns
}

def newest-release [name: string] {
    let url = $"($NPM)/(encode-name $name)/latest"
    let response = (fetch $url)
    if $response.status != 200 { error make { msg: $"($url) answered ($response.status)" } }
    let version = ($response.body | from json | get -o version)
    if $version == null or ($version | describe) != 'string' {
        error make { msg: $"($url) carries no version" }
    }
    $version
}

# The digest of one release's bytes, or null when the package CDN refuses to serve it.
def release-digest [name: string, version: string] {
    let url = $"($CDN)/($name)@($version)/icons.json"
    let response = (fetch $url)
    # jsDelivr refuses a file above its size limit, such as fluent-emoji's 103 MB package, so that
    # collection stays without a preset and is declared as a url with a sha256 instead.
    if $response.status == 403 { return null }
    if $response.status != 200 { error make { msg: $"($url) answered ($response.status)" } }
    $response.body | into binary | hash sha256
}

# Percent-encode one path segment: url encode escapes the hyphen encodeURIComponent keeps.
def encode-name [name: string] {
    if ($name =~ "^[A-Za-z0-9_.!~*()'-]+$") { $name } else { $name | url encode }
}

def main [...collections: string] {
    let root = ($env.FILE_PWD | path dirname | path dirname)
    let table = ($root | path join $TABLE)
    let pinned = (if ($table | path exists) { parse-table (open --raw $table) } else { [] })
    let targets = (
        (if ($collections | is-empty) { published } else { $collections })
        | append ($pinned | each {|collection| $collection.name})
        | uniq
        | sort
    )
    let results = (
        $targets | par-each --threads $CONCURRENCY {|name|
            try {
                let version = (newest-release $name)
                let known = ($pinned | where {|collection| $collection.name == $name } | get -o 0.releases | default [])
                if ($known | any {|release| $release.version == $version }) {
                    { name: $name, kind: 'current' }
                } else {
                    let sha256 = (release-digest $name $version)
                    if $sha256 == null {
                        { name: $name, kind: 'refused', version: $version }
                    } else {
                        { name: $name, kind: 'added', version: $version, sha256: $sha256 }
                    }
                }
            } catch {|failure|
                { name: $name, kind: 'failed', error: $failure.msg }
            }
        }
    )
    let failures = ($results | where {|result| $result.kind == 'failed' })
    for failure in $failures { print -e $"error: ($failure.name): ($failure.error)" }
    if ($failures | is-not-empty) {
        error make { msg: $"($failures | length) collection(s) could not be checked; the table was not written" }
    }
    let added = ($results | where {|result| $result.kind == 'added' })
    let refreshed = (
        $pinned | each {|collection|
            let fresh = (
                $added
                | where {|result| $result.name == $collection.name }
                | each {|result| { version: $result.version, sha256: $result.sha256 } }
            )
            { name: $collection.name, releases: (sort-releases ($collection.releases ++ $fresh)) }
        }
    )
    let discovered = (
        $added
        | where {|result| not ($pinned | any {|collection| $collection.name == $result.name }) }
        | each {|result| { name: $result.name, releases: [{ version: $result.version, sha256: $result.sha256 }] } }
    )
    let ordered = ($refreshed ++ $discovered)
    render $ordered | save --force $table

    let formatted = (try { ^rustfmt --edition 2024 $table | complete } catch { null })
    if $formatted == null {
        print -e 'warning: rustfmt is unavailable'
    } else if $formatted.exit_code != 0 {
        let detail = (if ($formatted.stderr | is-empty) { $formatted.stdout } else { $formatted.stderr } | str trim)
        error make { msg: $"rustfmt refused the generated table: ($detail)" }
    }

    for result in ($results | where {|result| $result.kind == 'refused' }) {
        print -e $"skipped ($result.name) ($result.version): the package CDN refuses to serve it"
    }
    for result in $added { print $"($result.name) ($result.version)" }
    print $"added ($added | length) releases; indexed ($ordered | length) collections"
}
